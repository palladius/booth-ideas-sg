---
const abilities = [
  "Strength",
  "Dexterity",
  "Constitution",
  "Intelligence",
  "Wisdom",
  "Charisma",
];

const classSuggestions = {
  Strength: ["Fighter", "Barbarian", "Paladin"],
  Dexterity: ["Rogue", "Ranger", "Monk"],
  Constitution: ["Barbarian", "Fighter", "Sorcerer"],
  Intelligence: ["Wizard", "Artificer"],
  Wisdom: ["Cleric", "Druid", "Ranger"],
  Charisma: ["Sorcerer", "Warlock", "Bard", "Paladin"],
};

let scores = new Array(abilities.length).fill(0);
let characterImage = "/placeholder.svg";
let suggestions = [];

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const imageFile = formData.get("character-image");

  if (imageFile && imageFile.size > 0) {
    const buffer = await imageFile.arrayBuffer();
    const base64 = Buffer.from(buffer).toString("base64");
    characterImage = `data:${imageFile.type};base64,${base64}`;
  }
  scores = abilities.map(() => Math.floor(Math.random() * 6) + 1 + Math.floor(Math.random() * 6) + 1 + Math.floor(Math.random() * 6) + 1);

  const maxScore = Math.max(...scores);
  const bestAbilities = abilities.filter((_, index) => scores[index] === maxScore);
  suggestions = [...new Set(bestAbilities.flatMap(ability => classSuggestions[ability]))];
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>D&D Character Sheet Generator</title>
    <style>
      body {
        font-family: sans-serif;
        background-color: #f0f0f0;
        color: #333;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }
      h1 {
        text-align: center;
        color: #8b0000;
      }
      .character-sheet {
        background-color: #fff;
        border: 2px solid #8b0000;
        border-radius: 10px;
        padding: 2rem;
      }
      .header {
        display: flex;
        align-items: center;
        margin-bottom: 2rem;
      }
      .character-image {
        width: 150px;
        height: 150px;
        border: 2px solid #8b0000;
        border-radius: 50%;
        margin-right: 2rem;
        object-fit: cover;
      }
      .abilities {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .ability {
        text-align: center;
      }
      .ability h3 {
        margin-bottom: 0.5rem;
      }
      .ability .score {
        font-size: 2rem;
        font-weight: bold;
      }
      .roll-button {
        display: block;
        margin: 0 auto;
        padding: 1rem 2rem;
        font-size: 1.2rem;
        background-color: #8b0000;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
      }
      .image-upload {
        margin-bottom: 2rem;
      }
      .suggestions {
        margin-top: 2rem;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <div class="character-sheet">
      <div class="header">
        <img class="character-image" src={characterImage} alt="Character Image" />
        <h1>D&D Character Sheet Generator</h1>
      </div>
      <form method="POST" enctype="multipart/form-data">
        <div class="image-upload">
          <label for="character-image">Character Image:</label>
          <input type="file" id="character-image" name="character-image" accept="image/*" />
        </div>
        <div class="abilities">
          {abilities.map((ability, index) => (
            <div class="ability">
              <h3>{ability}</h3>
              <div class="score">{scores[index]}</div>
            </div>
          ))}
        </div>
        <button type="submit" class="roll-button">Roll for Ability Scores</button>
      </form>
      {suggestions.length > 0 && (
        <div class="suggestions">
          <h2>Class Suggestions</h2>
          <p>Based on your scores, you might enjoy playing a: {suggestions.join(", ")}</p>
        </div>
      )}
    </div>
  </body>
</html>